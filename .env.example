# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋되지 않는다.
#
#   cp .env.example .env

# 배포 주소. OG 태그의 canonical URL과 "링크 복사" 기능이 이 값을 쓴다.
# 설정하지 않으면 http://localhost:8000 으로 동작한다.
GATSBY_SITE_URL=https://example.com

# 카카오 JavaScript 키 (https://developers.kakao.com > 내 애플리케이션 > 앱 키)
# 카카오 개발자 콘솔에서 사이트 도메인을 반드시 등록해야 동작한다.
# 비워 두면 카카오톡 공유 버튼 없이 링크 복사만 제공된다.
GATSBY_KAKAO_JAVASCRIPT_KEY=
